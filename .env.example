# This file documents local development defaults. For the hosted deploy (Fly.io, ADR 0012)
# these same keys are set as `fly secrets set ...` / fly.toml [env] with prod values — see
# the setup notes in fly.toml. Never commit real secrets; copy this to .env.local (gitignored).

# Backend
DATABASE_URL=sqlite:///./data/penta_screener.db
# Fail-closed provenance stamp for evidence-bearing eval exports. Use true only
# for a local database containing entirely fictional application data.
APPLICATION_DATA_IS_SYNTHETIC=false
SESSION_SECRET=change-me-in-.env.local
# FRONTEND_URL doubles as the deploy's origin. In prod it's https://... which also flips the
# session cookie to Secure (see Settings.secure_cookies); keep it http://localhost in dev.
FRONTEND_URL=http://localhost:5173
# The applicant experience shares Vite locally and moves to its own hostname in production.
APPLICANT_FRONTEND_URL=http://localhost:5173

# Google OAuth. In dev you can point at the downloaded client-secrets JSON; in prod set
# GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET directly (they take precedence over the file) so no
# secret file ships in the image. GOOGLE_REDIRECT_URI must be an authorized URI in the Google
# Cloud console — the prod value is https://<host>/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=./secrets/google-oauth-client.json
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# AWS Bedrock (the AI provider). Locally these come from your ambient AWS profile/SSO; in the
# hosted deploy (not on AWS, so no IAM role) set them as Fly secrets — a dedicated IAM user
# scoped to only bedrock:InvokeModel in us-west-2. AWS_REGION matches the app's region default.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2

# Direct model providers. Configure one or both to make their model routes selectable
# in Admin Settings. Keep real keys only in .env.local / Fly secrets.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Transactional email. Capture mode sends nothing. Development mode prefixes subjects and
# permits only exact jeffo.net or pentacoop.com sender, Reply-To, and recipient domains.
EMAIL_DELIVERY_MODE=capture
SOCKETLABS_SERVER_ID=
SOCKETLABS_INJECTION_API_KEY=
SOCKETLABS_GATEWAY=https://inject-cx.socketlabs.com/api/v1/email

# Passwordless credentials use the day / week / month policy agreed for M21. Repeated
# requests are coalesced for one minute and limited per identity to prevent mailbox flooding.
MAGIC_LINK_LIFETIME_HOURS=24
MAGIC_LINK_REQUEST_LIMIT=3
MAGIC_LINK_RATE_WINDOW_MINUTES=15
MAGIC_LINK_COALESCE_SECONDS=60
RECENT_AUTHENTICATION_MINUTES=1440
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30

# Frontend. Vite reads its own `frontend/.env.local`; copy `frontend/.env.example` there.
