# Vite reads this directory's .env.local when it starts. These browser values are public
# identifiers, but the API key must stay restricted to the expected HTTP referrers and the
# Google Picker API in Google Cloud.
VITE_API_BASE_URL=http://localhost:8000
VITE_GOOGLE_PICKER_API_KEY=
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_PROJECT_NUMBER=
